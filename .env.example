DISCORD_TOKEN=your_discord_bot_token
FACEIT_API_KEY=your_faceit_api_key
SHAME_CHANNEL_ID=123456789012345678
# FaceIT UUID, Steam ID (17 digits), or exact nickname — comma-separated
FACEIT_PLAYER_IDS=player-uuid-1,76561198000000000,TheirNick
KILL_THRESHOLD=10
POLL_INTERVAL_SECONDS=300
HISTORY_LIMIT=30
POST_HISTORY_ON_STARTUP=true
STATE_FILE=state.json
BOT_STATS_TITLE=BRWNr Bot Stats:

# Optional: rolling stats slash command (same DISCORD_TOKEN; no new API keys)
# STATS_COMMAND_ANY_CHANNEL=false

# Optional: weekly digest in shame channel (off by default)
# WEEKLY_DIGEST_ENABLED=false
# WEEKLY_DIGEST_CRON_DAY=0
# WEEKLY_DIGEST_HOUR_UTC=18
