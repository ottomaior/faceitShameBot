DISCORD_TOKEN=your_discord_bot_token
FACEIT_API_KEY=your_faceit_api_key
SHAME_CHANNEL_ID=123456789012345678
# Optional separate channels (default: everything goes to SHAME_CHANNEL_ID)
# FAME_CHANNEL_ID=        # Wall of Fame + Redemption Arc posts
# POSTMORTEM_CHANNEL_ID=  # automatic post-mortems
# FaceIT UUID, Steam ID (17 digits), or exact nickname — comma-separated
FACEIT_PLAYER_IDS=player-uuid-1,76561198000000000,TheirNick

# --- detection ---------------------------------------------------------------
KILL_THRESHOLD=10
# Grey zone: KILL_THRESHOLD..+2 kills still shame when 2 of {K/D < 0.65, ADR < 55, worst on team w/ blame >= 35%}
# hold, or one extreme signal (K/D < 0.5 / ADR < 45). 0 disables. See README.
SHAME_GREY_ZONE=3
# SHAME_GREY_KD=0.65
# SHAME_GREY_ADR=55
# SHAME_GREY_BLAME_SHARE=35
# SHAME_GREY_MIN_SIGNALS=2
# SHAME_GREY_KD_HARD=0.5
# SHAME_GREY_ADR_HARD=45
# SHAME_GREY_RETROACTIVE=false
# "Redemption arc" post: shame streak >= 2 going in, then this many kills
REDEMPTION_KILLS=25
# "Highlight" post for big games / aces (set false to keep the channel shame-only)
GLORY_POSTS_ENABLED=true
GLORY_KILLS=30
# Wall of Fame carry rule: top-fragger of the lobby + best on the team (share of team output >= FAME_CARRY_SHARE%)
# with >= FAME_CARRY_KILLS kills and K/D >= FAME_CARRY_KD or ADR >= FAME_CARRY_ADR
# FAME_CARRY_KILLS=20
# FAME_CARRY_KD=1.5
# FAME_CARRY_ADR=90
# FAME_CARRY_SHARE=28
# "Liability" post: >= KILL_THRESHOLD kills but the team's decisive worst (blame share, see README)
LIABILITY_POSTS_ENABLED=true
LIABILITY_BLAME_SHARE=35
LIABILITY_CLOSE_WIN_MARGIN=3
LIABILITY_MAX_KD=0.9
# LIABILITY_RETROACTIVE=false

# --- polling / history -------------------------------------------------------
# 120s is recommended so ELO changes attribute cleanly to single matches
POLL_INTERVAL_SECONDS=60
# Recent games for posts, /wall recent and the "last N" stats (HISTORY_LIMIT is an alias)
POST_HISTORY_LIMIT=30
POST_HISTORY_ON_STARTUP=true
# On Railway mount a Volume at /data and use STATE_FILE=/data/state.json
STATE_FILE=state.json

# Full CS2 history stats cache (one-time; skipped once completed and state persists)
STATS_BACKFILL_ON_STARTUP=true
STATS_BACKFILL_SLEEP_SECONDS=1

# --- presentation ------------------------------------------------------------
BOT_STATS_TITLE=BRWNr Bot Stats:
# Reactions added to every shame post (comma-separated emoji)
SHAME_REACTIONS=🤡
# brutal | friendly (reserved for future pools)
ROAST_LEVEL=brutal
# Optional file with your own roast lines (see roasts_custom.txt.example)
CUSTOM_ROASTS_FILE=roasts_custom.txt

# --- mentions / permissions --------------------------------------------------
# FaceIT nickname -> Discord user ID (pings on posts; also lets /profile & /last default to "you")
# FACEIT_DISCORD_MENTIONS=ExactNick:123456789012345678,OtherNick:987654321098765432
# MENTION_SHAMED_ON_POST=true
# STATS_COMMAND_ANY_CHANNEL=false
# Discord user IDs allowed to run /shametest
# ADMIN_DISCORD_IDS=123456789012345678

# --- ELO ---------------------------------------------------------------------
ELO_TRACKING_ENABLED=true

# --- automatic post-mortem ----------------------------------------------------
# After every match with POSTMORTEM_MIN_TRACKED tracked players on one team, post a post-mortem as soon as
# FaceIT has the stats. If Leetify has not processed the match yet, the post is edited in place once it has
# (checked every POSTMORTEM_LEETIFY_CHECK_SECONDS, for up to POSTMORTEM_LEETIFY_WAIT_MINUTES).
POSTMORTEM_AUTO=true
POSTMORTEM_MIN_TRACKED=2
POSTMORTEM_LEETIFY_WAIT_MINUTES=360
POSTMORTEM_LEETIFY_CHECK_SECONDS=180

# --- Leetify (external analytics for /compare and /profile) ------------------
# Optional key from https://leetify.com/app/developer — without it Leetify applies stricter rate limits
LEETIFY_ENABLED=true
LEETIFY_API_KEY=

# --- weekly digest (off by default) ------------------------------------------
# WEEKLY_DIGEST_ENABLED=false
# WEEKLY_DIGEST_CRON_DAY=0
# WEEKLY_DIGEST_HOUR_UTC=18
