DISCORD_TOKEN=your_discord_bot_token
FACEIT_API_KEY=your_faceit_api_key
SHAME_CHANNEL_ID=123456789012345678
# FaceIT UUID, Steam ID (17 digits), or exact nickname — comma-separated
FACEIT_PLAYER_IDS=player-uuid-1,76561198000000000,TheirNick
KILL_THRESHOLD=10
POLL_INTERVAL_SECONDS=300
# Recent games for shame posts and /shamestats_recent (HISTORY_LIMIT is an alias)
POST_HISTORY_LIMIT=30
POST_HISTORY_ON_STARTUP=true
STATE_FILE=state.json
BOT_STATS_TITLE=BRWNr Bot Stats:

# Full CS2 history stats cache for /shamestats_all and /glorystats (no old shame posts)
STATS_BACKFILL_ON_STARTUP=true
STATS_BACKFILL_SLEEP_SECONDS=1

# Optional: FaceIT nickname -> Discord user ID (mentions on shame posts only)
# FACEIT_DISCORD_MENTIONS=ExactNick:123456789012345678,OtherNick:987654321098765432
# MENTION_SHAMED_ON_POST=true

# Optional: slash commands (same DISCORD_TOKEN; no new API keys)
# STATS_COMMAND_ANY_CHANNEL=false

# Optional: weekly digest in shame channel (off by default)
# WEEKLY_DIGEST_ENABLED=false
# WEEKLY_DIGEST_CRON_DAY=0
# WEEKLY_DIGEST_HOUR_UTC=18
